{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saas-analytics-platform",
  "compatibility_date": "2025-09-01",
  "main": "src/server/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saas-analytics-db",
      "database_id": "PLACEHOLDER_REPLACE_WITH_REAL_D1_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "saas-analytics-storage"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "PLACEHOLDER_REPLACE_WITH_REAL_KV_ID"
    }
  ],
  "vars": {
    "APP_VERSION": "1.0.0"
  }
  // Secrets — set via `npx wrangler secret put <NAME>`, NEVER in this file:
  //   SESSION_SECRET          — HMAC key for session tokens
  //   BOOTSTRAP_ADMIN_EMAIL   — initial super admin email
  //   BOOTSTRAP_ADMIN_PASSWORD — initial super admin password
}
